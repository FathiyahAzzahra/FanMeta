rules_version = '2';

// Firestore Security Rules untuk FanMeta.
//
// Catatan penting: aplikasi Streamlit mengakses Firestore lewat Firebase Admin SDK
// (service account). Admin SDK TIDAK terkena rules ini; pemisahan data antar pengguna
// di aplikasi dijamin oleh kode (selalu memakai uid dari login). Rules ini adalah
// lapisan pengaman kedua untuk akses langsung dari luar (misalnya browser/aplikasi lain
// yang memakai API key Firebase): hanya pemilik akun yang boleh membaca/menulis datanya.
//
// Pasang lewat Firebase Console -> Firestore Database -> Rules -> tempel -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // Semua data pribadi pengguna: riwayat analisis, cerita Workspace, bab, profil.
    //   users/{uid}/history/{analysisId}
    //   users/{uid}/works/{workId}
    //   users/{uid}/works/{workId}/chapters/{chapterId}
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Dokumen profil users/{uid} itu sendiri (tidak tercakup pola di atas).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Selain itu (termasuk koleksi galeri public_works yang dinonaktifkan) ditolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
